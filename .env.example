# ---------------------------------------------------------------------------
# GraphFlow environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Restricted application role (no superuser, no BYPASSRLS). Used by the web
# app and the worker for every normal query, so Row-Level Security applies.
DATABASE_URL="postgresql://graphflow_app:graphflow_app_dev_password@localhost:5433/graphflow?schema=public"

# Privileged owner role. Used ONLY by Prisma migrations and the trusted seed.
MIGRATION_DATABASE_URL="postgresql://graphflow:graphflow_dev_password@localhost:5433/graphflow?schema=public"

# Integration-test databases (separate database inside the same container).
TEST_DATABASE_URL="postgresql://graphflow_app:graphflow_app_dev_password@localhost:5433/graphflow_test?schema=public"
TEST_MIGRATION_DATABASE_URL="postgresql://graphflow:graphflow_dev_password@localhost:5433/graphflow_test?schema=public"

# Docker Compose variables (used by docker-compose.yml)
POSTGRES_PASSWORD="graphflow_dev_password"
APP_DB_PASSWORD="graphflow_app_dev_password"
POSTGRES_PORT=5433
REDIS_PORT=6379

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# Public base URL of the web app (used for CSRF origin checks and links)
APP_URL="http://localhost:3000"

# Secret used to HMAC session, reset and invitation tokens. 32+ random chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret-value-0123456789"

# Session lifetime in hours
SESSION_TTL_HOURS=12

# DEMO mode shows the DEMO banner and demo account hints on the login page.
# MUST be "false" in production. The seed script refuses to run in production.
DEMO_MODE=true

# Worker
WORKER_HEALTH_PORT=9100
WORKER_CONCURRENCY=4
# How often (seconds) the PostgreSQL recovery scan re-enqueues stuck events
RECOVERY_SCAN_INTERVAL_SECONDS=30
